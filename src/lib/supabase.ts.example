import { createClient } from '@supabase/supabase-js';

// Initialize database client using environment variables
const supabaseKey = import.meta.env.VITE_SUPABASE_ANON_KEY || '';

if (!supabaseKey) {
  console.warn('Missing Supabase configuration. Please set VITE_SUPABASE_ANON_KEY environment variable in your .env.local file.');
}

// Use placeholder values if not configured to prevent app crash during development
// Note: These placeholder values will not connect to a real database
const finalUrl = 'https://demo.supabase.co';
const finalKey = supabaseKey || 'demo-key';

const supabase = createClient(finalUrl, finalKey);

export { supabase };
