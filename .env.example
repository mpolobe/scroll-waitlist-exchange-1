# ===========================================
# ALCHEMY ACCOUNT KIT (Polygon Mainnet)
# ===========================================
# Get your API key from: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Alchemy Account Kit App ID
VITE_ALCHEMY_APP_ID=6q0y1xpzxlz05jc0

# Gas Manager Policy ID for sponsored transactions (staff operations)
# Create a policy at: https://dashboard.alchemy.com/services/gas-manager
VITE_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id_here

# AFRC Token Contract on Polygon Mainnet (POL)
VITE_AFRC_CONTRACT_ADDRESS=0xfcfa02a852551618f544fbce52908a0f941abef9

# ===========================================
# AFRICA'S TALKING SMS (Primary)
# ===========================================
# Get credentials from: https://account.africastalking.com/
VITE_AFRICAS_TALKING_API_KEY=your_africas_talking_api_key_here
VITE_AFRICAS_TALKING_USERNAME=your_africas_talking_username_here

# ===========================================
# TWILIO SMS (Fallback)
# ===========================================
# Get credentials from: https://console.twilio.com/
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# SUI NETWORK (Phone Wallet)
# ===========================================
VITE_SUI_NETWORK=mainnet
VITE_AFC_COIN_TYPE=0xc68c4cfb63d702227db09c28837e75abd23bbb3adc192e3bc45fecca4dd5b7e8::afc::AFC

# Wallet Salt (for deterministic address generation)
VITE_WALLET_SALT=africoin-wallet-v1-production

# Supabase Configuration
# Vercel Supabase Project: supabase-teal-window
# Project URL: https://llvprbmrnjvamjzavmhg.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# EMAIL SERVICE (Resend) - Configure in Supabase Dashboard
# ===========================================
# Supabase SMTP Settings (Dashboard → Project Settings → Authentication → SMTP):
# Host: smtp.resend.com
# Port: 465
# Username: resend
# Password: Your Resend API key (re_xxxxx)
# Sender email: noreply@yourdomain.com
# Sender name: Africoin
#
# Get your Resend API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Supabase Configuration (for build/deployment scripts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# PostgreSQL Connection (from Supabase)
POSTGRES_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres
POSTGRES_PRISMA_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Vercel Edge Config (for Famous.AI database migration)
# Get from Vercel Dashboard > Storage > Edge Config
EDGE_CONFIG=your_edge_config_connection_string_here
# OR use Famous.AI specific token (placeholder - replace with actual token)
FAMOUS_AI_EDGE_CONFIG_TOKEN=your_famous_ai_edge_config_token_here

# Gemini AI Configuration
# Project: AfriCoin-Sovereign-Key (5780586642)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# SENT AIRDROP CONFIGURATION (Polygon Mainnet)
# ===========================================
# 
# REQUIRED FOR PRODUCTION - All 4 variables must be set:
#
# 1. THIRDWEB_SECRET_KEY - Backend signing (get from thirdweb.com/dashboard)
# 2. ADMIN_PRIVATE_KEY - Wallet that approved SENT spending to Airdrop contract
# 3. SUPABASE_URL - Database for quiz scores and claim tracking
# 4. SUPABASE_SERVICE_KEY - Service role key for backend database access
#
# Contract Addresses (hardcoded in api/airdrop/sign.ts):
# - SENT Token: 0xF379f21Af5967F26c358568Bb60408DB8B4F7fE5
# - Airdrop Contract: 0x7175F1b0A27ebD20Cb9CA00f915C6670b4596bcf
#
# Admin Wallet: 0xfcfa02a852551618f544fbce52908a0f941abef9
# - Must have 1-2 POL for gas fees
# - Must have approved Airdrop contract to spend SENT tokens
# ===========================================

# Thirdweb Configuration
VITE_THIRDWEB_CLIENT_ID=851b38f210a7efd81ae6ca7cc76b26fd
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# Admin wallet private key (for signing airdrop claims)
# This is the wallet that approved the Airdrop contract to spend SENT tokens
# SECURITY: Never commit the actual private key - set in production environment only
ADMIN_PRIVATE_KEY=your_admin_private_key_here

# Supabase Configuration for Airdrop Backend
# The sign.ts API uses these to verify quiz scores and track claims
SUPABASE_URL=https://llvprbmrnjvamjzavmhg.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# BrowserStack Testing Configuration
# Get credentials from: https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=benjaminmpolokos_dzbone
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key_here
BROWSERSTACK_URL=http://benjaminmpolokos_dzbone.browserstack.com

# Android Code Signing
# Generate keystore with: keytool -genkey -v -keystore africoin-release.keystore -alias africoin -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH=./android/app/africoin-release.keystore
ANDROID_KEYSTORE_PASSWORD=your_keystore_password_here
ANDROID_KEY_ALIAS=africoin
ANDROID_KEY_PASSWORD=your_key_password_here

# Google Cloud Project
GOOGLE_CLOUD_PROJECT_ID=gen-lang-client-0453426956
GOOGLE_CLOUD_PROJECT_NUMBER=834148498046

# Google Play Store
# Get from: https://play.google.com/console/developers/8975457855584245860/api-access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./google-play-service-account.json

# Database Migration (for deployment script)
# Source database (Famous.AI)
# Famous.AI Edge Configuration Name: Famous-AI
# Token: fd6b6ddc-e56a-441f-9b24-abca65e9eb37
SOURCE_SUPABASE_URL=https://your-famous-ai-project.supabase.co
SOURCE_SUPABASE_KEY=your_famous_ai_service_role_key_here

# Target database (Vercel deployment - supabase-teal-window)
# Project URL: https://llvprbmrnjvamjzavmhg.supabase.co
# Source database (Famous.AI) - Auto-configured via Edge Config if available
# Otherwise, provide these manually:
SOURCE_SUPABASE_URL=https://your-famous-ai-project.supabase.co
SOURCE_SUPABASE_KEY=your_famous_ai_service_role_key_here

# Target database (Vercel deployment) - Required for migration
TARGET_SUPABASE_URL=https://your-vercel-project.supabase.co
# Target database (Vercel deployment - Supabase project: llvprbmrnjvamjzavmhg)
TARGET_SUPABASE_URL=https://llvprbmrnjvamjzavmhg.supabase.co
TARGET_SUPABASE_KEY=your_vercel_service_role_key_here
