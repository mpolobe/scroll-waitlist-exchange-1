# Alchemy Account Kit Configuration
# Get your API key from: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Gas Manager Policy ID for sponsored transactions
# Create a policy at: https://dashboard.alchemy.com/services/gas-manager/configuration
VITE_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id_here

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini AI Configuration
# Project: AfriCoin-Sovereign-Key (5780586642)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# BrowserStack Testing Configuration
# Get credentials from: https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=benjaminmpolokos_dzbone
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key_here
BROWSERSTACK_URL=http://benjaminmpolokos_dzbone.browserstack.com

# Android Code Signing
# Generate keystore with: keytool -genkey -v -keystore africoin-release.keystore -alias africoin -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH=./android/app/africoin-release.keystore
ANDROID_KEYSTORE_PASSWORD=your_keystore_password_here
ANDROID_KEY_ALIAS=africoin
ANDROID_KEY_PASSWORD=your_key_password_here

# Google Cloud Project
GOOGLE_CLOUD_PROJECT_ID=gen-lang-client-0453426956
GOOGLE_CLOUD_PROJECT_NUMBER=834148498046

# Google Play Store
# Get from: https://play.google.com/console/developers/8975457855584245860/api-access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./google-play-service-account.json
