# Alchemy Account Kit Configuration
# Get your API key from: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Gas Manager Policy ID for sponsored transactions
# Create a policy at: https://dashboard.alchemy.com/services/gas-manager/configuration
VITE_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id_here

# Supabase Configuration
# Vercel Supabase Project: supabase-teal-window
# Project URL: https://llvprbmrnjvamjzavmhg.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Configuration (for build/deployment scripts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# PostgreSQL Connection (from Supabase)
POSTGRES_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres
POSTGRES_PRISMA_URL=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Vercel Edge Config (for Famous.AI database migration)
# Get from Vercel Dashboard > Storage > Edge Config
EDGE_CONFIG=your_edge_config_connection_string_here
# OR use Famous.AI specific token (placeholder - replace with actual token)
FAMOUS_AI_EDGE_CONFIG_TOKEN=your_famous_ai_edge_config_token_here

# Gemini AI Configuration
# Project: AfriCoin-Sovereign-Key (5780586642)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# BrowserStack Testing Configuration
# Get credentials from: https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=benjaminmpolokos_dzbone
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key_here
BROWSERSTACK_URL=http://benjaminmpolokos_dzbone.browserstack.com

# Android Code Signing
# Generate keystore with: keytool -genkey -v -keystore africoin-release.keystore -alias africoin -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH=./android/app/africoin-release.keystore
ANDROID_KEYSTORE_PASSWORD=your_keystore_password_here
ANDROID_KEY_ALIAS=africoin
ANDROID_KEY_PASSWORD=your_key_password_here

# Google Cloud Project
GOOGLE_CLOUD_PROJECT_ID=gen-lang-client-0453426956
GOOGLE_CLOUD_PROJECT_NUMBER=834148498046

# Google Play Store
# Get from: https://play.google.com/console/developers/8975457855584245860/api-access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./google-play-service-account.json

# Database Migration (for deployment script)
# Source database (Famous.AI)
# Famous.AI Edge Configuration Name: Famous-AI
# Token: fd6b6ddc-e56a-441f-9b24-abca65e9eb37
SOURCE_SUPABASE_URL=https://your-famous-ai-project.supabase.co
SOURCE_SUPABASE_KEY=your_famous_ai_service_role_key_here

# Target database (Vercel deployment - supabase-teal-window)
# Project URL: https://llvprbmrnjvamjzavmhg.supabase.co
# Source database (Famous.AI) - Auto-configured via Edge Config if available
# Otherwise, provide these manually:
SOURCE_SUPABASE_URL=https://your-famous-ai-project.supabase.co
SOURCE_SUPABASE_KEY=your_famous_ai_service_role_key_here

# Target database (Vercel deployment) - Required for migration
TARGET_SUPABASE_URL=https://your-vercel-project.supabase.co
# Target database (Vercel deployment - Supabase project: llvprbmrnjvamjzavmhg)
TARGET_SUPABASE_URL=https://llvprbmrnjvamjzavmhg.supabase.co
